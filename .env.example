# Stratageo Site Suitability Portal — frontend build variables
#
# Copy to .env.local. Vite bakes these in at build time.

# URL of the deployed engine (Python/FastAPI on Cloud Run). Required.
# Local engine: http://localhost:8000
VITE_PY_BACKEND_URL=

# Rotatable kill-switch token sent as X-App-Token with every engine request.
# Must match the engine's APP_SHARED_TOKEN. Not a secret — it ships in the bundle.
VITE_APP_TOKEN=
