# Stratageo Site Suitability Portal — Environment Variables
#
# Copy this file to .env.local and fill in values.
# These variables are used by the Vite frontend build (baked in at build time).

# ── Current production path — the conversational v2 engine (Python/FastAPI on
#    Google Cloud Run) ────────────────────────────────────────────────────────
# URL of the deployed Cloud Run engine service.
# Example: https://stratageo-engine-xxxxx.asia-south1.run.app
VITE_PY_BACKEND_URL=

# Set to "1" to enable the conversational v2 flow (multi-turn chat, analyses
# run via /api/v2 on VITE_PY_BACKEND_URL). This is what production uses.
VITE_CONVERSATIONAL_MODE=

# Rotatable kill-switch token sent as X-App-Token with every engine request.
# Must match the backend's APP_SHARED_TOKEN.
VITE_APP_TOKEN=

# ── Legacy fallback path (pre-conversational-engine demo mode) ───────────────
# Not used by the deployed production build; kept for local experimentation
# without a backend. 'demo' uses pre-built scenarios and template
# explanations; 'live' calls OSM APIs directly + an optional AI backend proxy.
VITE_APP_MODE=demo
VITE_AI_BACKEND_URL=
