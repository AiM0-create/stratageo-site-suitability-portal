# Copy to .env and fill in. NEVER commit the real .env.
OPENAI_API_KEY=sk-...
GOOGLE_PLACES_API_KEY=AIza...
ORS_API_KEY=...
# Comma-separated allowed origins for CORS
FRONTEND_ORIGINS=http://localhost:5173,https://aim0-create.github.io
# Experimental LLM-written custom-layer execution. Keep off unless needed.
SANDBOX_ENABLED=false
# Chat model (conversation + spec extraction). Engine explanations use gpt-4o-mini.
CHAT_MODEL=gpt-4o

# ── Abuse / cost protection (SecurityMiddleware) ──
# Rotatable kill-switch: if set, requests must send X-App-Token with this value.
# Leave blank for open access (rate-limit only). In production this matches the
# frontend's VITE_APP_TOKEN build value.
APP_SHARED_TOKEN=
# Per-IP and whole-service request ceilings (cost-bearing endpoints only).
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=200
MAX_REQUEST_BYTES=262144
# In production, API keys come from Secret Manager via --set-secrets, not these.
